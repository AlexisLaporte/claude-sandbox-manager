# /etc/oto-runner/abonnement.env — 0600, propriétaire oto-runner. Jamais commité rempli.
OTO_RUNNER_PROVIDER=claude-subscription
OTO_RUNNER_ARMED=1
# Préprod (mcp.example.com) pour la recette, prod (mcp.example.com) ensuite — même base, même file.
OTO_BASE=https://mcp.example.com
OTO_MCP_URL=https://mcp.example.com/mcp
# Secret machine du worker (oto_admin_runner_worker), 1Password.
OTO_WORKER_SECRET=otow_…
# L'agent de la box, et son jeton (= FERME_TOKEN de /etc/ferme/agent.env, 1Password).
OTO_FERME_URL=http://10.0.0.2:8190
OTO_FERME_TOKEN=…
