# /etc/oto-runner/farm.env — 0600, propriétaire oto-runner. Jamais commité rempli.
# Aucun secret ici : OTO_WORKER_SECRET et OTO_FERME_TOKEN viennent du Secret Manager au
# démarrage (deploy/secrets.sh, profil `worker-farm`).
OTO_RUNNER_PROVIDER=claude-farm
# Clés clients seules : le worker ne tourne que sur la clé API déposée par l'org du travail,
# jamais sur une clé à lui (obligatoire pour claude-farm : sans lui, refus au démarrage).
OTO_RUNNER_ORG_KEYS_ONLY=1
OTO_RUNNER_ARMED=1
OTO_BASE=https://mcp.example.com
OTO_MCP_URL=https://mcp.example.com/mcp
# L'agent de la box, sur le réseau privé.
OTO_FERME_URL=http://10.0.0.2:8190
# Les orgs que CE worker sert, et elles seules : identifiants séparés par des virgules
# (`12,34`). Absent = toutes. Pour essayer le moteur sur une org avant de le donner au parc.
OTO_RUNNER_ORGS=<id>,<id>
