# Worker oto-runner `anthropic` (la boucle maison) — sur la box de la ferme, SANS sandbox.
# Il sert les travaux de la famille `anthropic` que la ferme ne prend pas : ceux d'une org
# NON routée vers la ferme, sur la clé que l'org a déposée ou, s'il en a l'accès, sur la clé
# PARTAGÉE de l'instance — réglée tour par tour à son budget (`OTO_RUNNER_METERS_USAGE=1`).
# Il ne détient AUCUNE clé de modèle (`OTO_RUNNER_ORG_KEYS_ONLY=1`, `ANTHROPIC_API_KEY` vide).
#
# Utilisateur DYNAMIQUE, jamais `oto-runner` : sous le même uid que les workers de la ferme et
# de l'abonnement, il lirait leur environnement (/proc/<pid>/environ), donc `OTO_FERME_TOKEN` et
# leurs secrets machine. Son secret `otow_` est PROPRE (profil `worker-anthropic`, drop-in
# 20-secrets.conf), lu par systemd avant le démarrage, comme son fichier d'env (root, 600).
#
# Arrêt gracieux : SIGTERM = ne plus réserver, finir, sortir. Un travail de la boucle tient
# sous 15 min : même patience que les workers de la boucle de la plateforme (16 min).
[Unit]
Description=oto-runner worker anthropic %i (boucle, clés d'org ou clé partagée mesurée)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/oto-runner-anthropic/anthropic.env
# Les journaux de passage (`passages/`, relatif au répertoire courant) : un dossier
# d'état à l'instance, seul endroit inscriptible.
StateDirectory=oto-runner-anthropic/%i
WorkingDirectory=%S/oto-runner-anthropic/%i
Environment=HOME=%S/oto-runner-anthropic/%i
ExecStart=/srv/oto-runner/.venv/bin/python -m oto_runner.worker
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=16min
SyslogIdentifier=oto-runner-anthropic-%i
MemoryMax=512M
# Durcissement : un client HTTP(S), rien d'autre.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Ce worker ne parle qu'au backend et au fournisseur, par Internet : ni l'agent de la ferme
# (réseau privé des sandboxes) ni l'adresse des métadonnées du cloud. Les noms ne se filtrent
# pas ici (IP seulement) : on ferme ce qu'il ne doit jamais atteindre.
IPAddressDeny=10.0.0.0/24 169.254.0.0/16
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
