# /etc/oto-runner-openrouter/openrouter-<n°>.env (un par instance) — root 600 (dossier root 700), lu par systemd seul. Écrit par deploy/worker-openrouter.sh.
# Aucun secret ici : OTO_WORKER_SECRET vient du Secret Manager au démarrage (deploy/secrets.sh,
# profil `worker-openrouter`).
OTO_RUNNER_PROVIDER=openai
# La voie Chat Completions, vers OpenRouter : l'hôte NOMME le dépôt de clé `openrouter`
# (oto-runner agent_llm_openai._DEPOTS_PAR_HOTE), donc la famille servie.
OTO_RUNNER_OPENAI_BASE=https://openrouter.ai/api/v1
# Le modèle du libellé de démarrage seulement : chaque travail porte le sien (famille
# `openrouter`), et le backend ne remet à ce worker que des travaux de cette famille.
OTO_RUNNER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Aucune clé à lui : la clé de l'org, ou la clé partagée à laquelle l'org a accès...
OTO_RUNNER_ORG_KEYS_ONLY=1
# ... et celle-ci seulement parce qu'il promet de réserver puis régler chaque appel au
# modèle (exige un backend qui règle la famille `openrouter`). Sans cette ligne, le backend rend ces travaux à la file.
OTO_RUNNER_METERS_USAGE=1
OTO_RUNNER_ARMED=1
OTO_BASE=https://mcp.example
OTO_MCP_URL=https://mcp.example/mcp
# VIDÉE À DESSEIN : un défaut futur échouerait fort au lieu de payer en silence.
OTO_RUNNER_OPENAI_API_KEY=
# Les orgs que CETTE instance sert (4ᵉ argument obligatoire de worker-openrouter.sh). Une
# restriction déclarée par le worker, pas une garde du serveur. Ligne absente = toutes
# (argument `toutes`).
OTO_RUNNER_ORGS=12
