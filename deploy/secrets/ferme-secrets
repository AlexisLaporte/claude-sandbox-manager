#!/usr/bin/env python3
"""Tire les secrets d'un service de box-agents depuis le Secret Manager Scaleway, au démarrage.

    ferme-secrets <profil>      profil = agent | worker | worker-farm | worker-anthropic | worker-openrouter

Écrit /run/ferme-secrets/<profil>.env (tmpfs, root 600), lu par l'unité via
EnvironmentFile=-/run/ferme-secrets/<profil>.env (le « - » : le fichier n'existe qu'après ce
script, lancé en ExecStartPre=+). Aucun secret métier sur disque : seule la clé IAM
/etc/ferme-secrets/scw-key (600), en LECTURE seule sur le seul projet de la box.

/etc/ferme-secrets/scw-key porte : SCW_ACCESS_KEY, SCW_SECRET_KEY, SCW_PROJECT_ID (le projet
Scaleway dédié à la box) et, facultatif, SCW_REGION (défaut fr-par).

Échoue fermé : secret introuvable, clé refusée, API muette → code ≠ 0, l'unité ne démarre
pas. Jamais de repli sur une ancienne valeur. Doctrine : docs/secrets.md (pattern des ponts).
"""
import base64, json, os, sys, urllib.request

PROFILS = {  # variable d'environnement → nom du secret
    "agent":  {"FERME_TOKEN": "ferme-token"},
    "worker": {"OTO_FERME_TOKEN": "ferme-token", "OTO_WORKER_SECRET": "oto-worker-secret-abonnement"},
    # Le worker `claude-farm` : son PROPRE secret machine, jamais celui de l'abonnement —
    # révoquer l'un ne coupe pas l'autre, et chacun se lit à part dans la présence.
    "worker-farm": {"OTO_FERME_TOKEN": "ferme-token", "OTO_WORKER_SECRET": "oto-worker-secret-ferme"},
    # Le worker `anthropic` (la boucle, sans sandbox) : son PROPRE secret machine, et pas le
    # jeton de l'agent — il ne parle jamais à la ferme.
    "worker-anthropic": {"OTO_WORKER_SECRET": "oto-worker-secret-anthropic"},
    # Le worker `openrouter` (la boucle, modèles ouverts) : son PROPRE secret machine aussi —
    # révoquer l'un des deux workers de la boucle ne coupe pas l'autre.
    "worker-openrouter": {"OTO_WORKER_SECRET": "oto-worker-secret-openrouter"},
}


def config():
    valeurs = {}
    for l in open("/etc/ferme-secrets/scw-key"):
        if "=" in l:
            k, v = l.split("=", 1)
            valeurs[k.strip()] = v.strip()
    for requise in ("SCW_SECRET_KEY", "SCW_PROJECT_ID"):
        if not valeurs.get(requise):
            raise SystemExit(f"{requise} absente de /etc/ferme-secrets/scw-key")
    return valeurs


def lire(conf, nom):
    api = f"https://api.scaleway.com/secret-manager/v1beta1/regions/{conf.get('SCW_REGION') or 'fr-par'}"
    url = (f"{api}/secrets-by-path/versions/latest/access?project_id={conf['SCW_PROJECT_ID']}"
           f"&secret_name={nom}&secret_path=/")
    jeton = conf["SCW_SECRET_KEY"]
    r = urllib.request.Request(url, headers={"X-Auth-Token": jeton})
    return base64.b64decode(json.load(urllib.request.urlopen(r, timeout=20))["data"]).decode()


def main():
    profil = sys.argv[1] if len(sys.argv) == 2 else None
    if profil not in PROFILS:
        raise SystemExit(f"usage : ferme-secrets {'|'.join(PROFILS)}")
    conf = config()
    lignes = []
    for var, nom in PROFILS[profil].items():
        v = lire(conf, nom)
        if not v or "\n" in v:
            raise SystemExit(f"secret {nom} vide ou multiligne : refus")
        lignes.append(f"{var}={v}")
    os.makedirs("/run/ferme-secrets", mode=0o700, exist_ok=True)
    # Un nom par processus : les workers d'un même profil démarrent ensemble et
    # s'arrachaient le même fichier temporaire (FileNotFoundError au os.replace).
    tmp = f"/run/ferme-secrets/.{profil}.{os.getpid()}.env"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lignes) + "\n")
    os.replace(tmp, f"/run/ferme-secrets/{profil}.env")
    print(f"ferme-secrets {profil} : {len(lignes)} variable(s) posée(s)")


main()
