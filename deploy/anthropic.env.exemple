# /etc/oto-runner/anthropic.env — 0600, propriétaire oto-runner. Écrit par deploy/worker-anthropic.sh.
# Aucun secret ici : OTO_WORKER_SECRET vient du Secret Manager au démarrage (deploy/secrets.sh,
# profil `worker-anthropic`).
OTO_RUNNER_PROVIDER=anthropic
# Aucune clé à lui : la clé de l'org, ou la clé partagée à laquelle l'org a accès...
OTO_RUNNER_ORG_KEYS_ONLY=1
# ... et celle-ci seulement parce qu'il promet de réserver puis régler chaque appel au
# modèle (exige un backend ≥ v1.548.0). Sans cette ligne, le backend rend ces travaux à la file.
OTO_RUNNER_METERS_USAGE=1
OTO_RUNNER_ARMED=1
OTO_BASE=https://mcp.example
OTO_MCP_URL=https://mcp.example/mcp
# VIDÉE À DESSEIN : un défaut futur échouerait fort au lieu de payer en silence.
ANTHROPIC_API_KEY=
