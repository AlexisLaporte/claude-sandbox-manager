[Unit]
Description=Ferme de Claude — agent de box (écoute sur le réseau privé, FERME_HOST)
After=network-online.target
Wants=network-online.target

[Service]
# FERME_HOST, FERME_RELAIS_PYTHON ; FERME_TOKEN vient du Secret Manager (drop-in 20-secrets.conf)
EnvironmentFile=/etc/ferme/agent.env
ExecStart=/usr/bin/python3 /opt/ferme/agent.py
Restart=on-failure
MemoryMax=150M

[Install]
WantedBy=multi-user.target
